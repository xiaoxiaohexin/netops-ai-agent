# NetOps AI Agent 大模型环境配置模板
# 复制本文件为 .env 并填入你的 API Key 即可生效:
# copy .env.example .env

# 选项 A: 阿里云通义千问 (Qwen) - 推荐
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
# 可选模型: qwen-max, qwen-plus, qwen-turbo, qwen2.5-72b-instruct
QWEN_MODEL=qwen-max

# 选项 B: OpenAI 官方或任何 OpenAI 兼容代理 (如 DeepSeek, Moonshot, 本地 vLLM)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 选项 C: 本地 Ollama 部署 (无需 API Key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
